# PostgreSQL
# Runtime traffic should use the provider's pooled URL. Prisma CLI migrations
# use DIRECT_URL so migration locks/session state do not pass through a pooler.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/teamflow?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/teamflow?sslmode=require"
# Local setup uses teamflow_dev and a separate, migrated teamflow_test database.
# For automated tests, pass TEST_DATABASE_URL explicitly in the command environment.
# TEST_DATABASE_URL="postgresql://YOUR_MAC_USER@127.0.0.1:5432/teamflow_test?schema=public"
# Optional demo password (12-128 characters); used only by development seeding.
# SEED_DEV_PASSWORD="choose-a-local-development-password"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"
AUTH_URL="https://teamflow.example.com"

# Google OAuth credentials (server only; AUTH_* is the Auth.js convention).
# Local Google Cloud authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# Optional aliases accepted by the server if your provider uses these names:
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Inngest — production keys are available in the Inngest dashboard.
# The local Inngest Dev Server works without keys.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV="1"

# Optional Phase 22 AI insights. Keep the organization feature switch off until
# provider/data-processing approval is complete. These values are server-only.
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Optional daily email delivery. Verify the sender domain in Resend and configure
# its webhook endpoint at /api/webhooks/resend before enabling an organization.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_WEBHOOK_SECRET=""
# Password setup/reset links use AUTH_URL, RESEND_API_KEY and RESEND_FROM_EMAIL.
# Auth emails are only sent from an address/domain verified in Resend.
# Local/staging sends are restricted to these comma-separated authorized recipients.
RESEND_TEST_RECIPIENTS=""

# Private object-storage uploads are not implemented yet.
# STORAGE_*=""
