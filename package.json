{
  "name": "team-management-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "inngest:dev": "npx --ignore-scripts=false inngest-cli@latest dev --no-discovery -u http://localhost:3000/api/inngest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "tsx --test lib/*.test.ts lib/**/*.test.ts tests/unit/*.test.ts",
    "test:migration:static": "tsx --test tests/unit/migration-target-guard.test.ts tests/unit/migration-catalog.test.ts",
    "test:integration": "NODE_ENV=test node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "typecheck": "next typegen && tsc --noEmit",
    "qa": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build",
    "check:production-env": "node scripts/check-production-env.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "org:bootstrap-admin": "tsx scripts/provision-organization-admin.ts",
    "db:studio": "prisma studio",
    "setup:local": "bash scripts/setup-local.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.4",
    "inngest": "^4.23.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.43.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "server-only": "0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
