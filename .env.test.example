# Phase 20 tests refuse to connect unless the host is loopback and the database
# name contains "test". Never point this variable at staging or production.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/teamflow_test?schema=public"

# Safe placeholders for rendering the public authentication UI in browser tests.
AUTH_SECRET="replace-with-at-least-32-characters-for-local-tests"
AUTH_GOOGLE_ID="browser-test-client-id"
AUTH_GOOGLE_SECRET="browser-test-client-secret"
